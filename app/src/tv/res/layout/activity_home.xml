<?xml version="1.0" encoding="utf-8"?>
<!--
TV 首页 — 左侧导航栏 + 内容区（Google TV 侧栏范式）
与 HomeActivity 共用同一套 View ID
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <!-- 左侧导航栏 -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="@dimen/tv_nav_width"
        android:layout_height="match_parent"
        android:background="@color/bg_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/tv_safe_vertical"
        android:paddingBottom="@dimen/tv_safe_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="FN TV"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/tv_text_section"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tabMovies"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/selector_tab"
            android:focusable="true"
            android:nextFocusRight="@+id/moviesGridContainer"
            android:nextFocusDown="@+id/tabLibrary"
            android:text="影视"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/tv_text_body" />

        <Button
            android:id="@+id/tabLibrary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/selector_tab"
            android:focusable="true"
            android:nextFocusRight="@+id/libraryGridContainer"
            android:nextFocusUp="@+id/tabMovies"
            android:nextFocusDown="@+id/tabSettings"
            android:text="媒体库"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/tv_text_body" />

        <Button
            android:id="@+id/tabSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/selector_tab"
            android:focusable="true"
            android:nextFocusRight="@+id/btnCheckUpdate"
            android:nextFocusUp="@+id/tabLibrary"
            android:text="设置"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/tv_text_body" />

    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/divider" />

    <!-- 右侧内容区 -->
    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingLeft="@dimen/tv_content_padding_horizontal"
        android:paddingTop="@dimen/tv_safe_vertical"
        android:paddingRight="@dimen/tv_safe_horizontal"
        android:paddingBottom="@dimen/tv_safe_vertical">

        <!-- Tab 1: 影视 -->
        <LinearLayout
            android:id="@+id/panelMovies"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:descendantFocusability="afterDescendants"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/moviesGridContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:descendantFocusability="afterDescendants"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tvMoviesLoading"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:gravity="center"
                        android:text="加载中..."
                        android:textColor="@color/text_hint"
                        android:textSize="@dimen/tv_text_body"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvMoviesEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:gravity="center"
                        android:text="请选择媒体库"
                        android:textColor="@color/text_hint"
                        android:textSize="@dimen/tv_text_body"
                        android:visibility="visible" />

                </LinearLayout>

            </ScrollView>

        </LinearLayout>

        <!-- Tab 2: 媒体库 -->
        <LinearLayout
            android:id="@+id/panelLibrary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <RelativeLayout
                android:id="@+id/libraryHeader"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="媒体库"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/tv_text_section"
                    android:textStyle="bold" />

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/libraryGridContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:descendantFocusability="afterDescendants"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tvLibraryLoading"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:gravity="center"
                        android:text="加载中..."
                        android:textColor="@color/text_hint"
                        android:textSize="@dimen/tv_text_body"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvLibraryEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:gravity="center"
                        android:text="暂无媒体库"
                        android:textColor="@color/text_hint"
                        android:textSize="@dimen/tv_text_body"
                        android:visibility="gone" />

                </LinearLayout>

            </ScrollView>

        </LinearLayout>

        <!-- Tab 3: 设置 -->
        <LinearLayout
            android:id="@+id/panelSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <RelativeLayout
                android:id="@+id/settingsHeader"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="设置"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/tv_text_section"
                    android:textStyle="bold" />

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="账户信息"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/tv_text_body"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:background="@color/divider" />

                        <TextView
                            android:id="@+id/tvSettingUsername"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="用户名: --"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/tv_text_body" />

                        <TextView
                            android:id="@+id/tvSettingServer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text=""
                            android:textColor="@color/text_hint"
                            android:textSize="@dimen/tv_text_caption" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="播放设置"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/tv_text_body"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:background="@color/divider" />

                        <RelativeLayout
                            android:id="@+id/rlDecoderSetting"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_input"
                            android:focusable="true"
                            android:nextFocusLeft="@+id/tabSettings"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:text="解码模式"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/tv_text_body" />

                            <TextView
                                android:id="@+id/tvDecoderValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:text="硬解"
                                android:textColor="@color/colorAccent"
                                android:textSize="@dimen/tv_text_body" />

                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/rlSeekStep"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_input"
                            android:focusable="true"
                            android:nextFocusLeft="@+id/tabSettings"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:text="快进退步长"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/tv_text_body" />

                            <TextView
                                android:id="@+id/tvSeekStepValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:text="10s"
                                android:textColor="@color/colorAccent"
                                android:textSize="@dimen/tv_text_body" />

                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/rlDanmuSetting"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_input"
                            android:focusable="true"
                            android:nextFocusLeft="@+id/tabSettings"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:text="弹幕服务器"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/tv_text_body" />

                            <TextView
                                android:id="@+id/tvDanmuUrl"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:ellipsize="end"
                                android:maxWidth="240dp"
                                android:singleLine="true"
                                android:text=""
                                android:textColor="@color/colorAccent"
                                android:textSize="@dimen/tv_text_caption" />

                        </RelativeLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="关于"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/tv_text_body"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:background="@color/divider" />

                        <TextView
                            android:id="@+id/tvVersionName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FN TV v1.0"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/tv_text_body" />

                        <Button
                            android:id="@+id/btnCheckUpdate"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_btn_primary"
                            android:focusable="true"
                            android:nextFocusLeft="@+id/tabSettings"
                            android:text="检查更新"
                            android:textAllCaps="false"
                            android:textColor="@color/text_white"
                            android:textSize="@dimen/tv_text_body" />

                        <Button
                            android:id="@+id/btnFeedback"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_input"
                            android:focusable="true"
                            android:nextFocusLeft="@+id/tabSettings"
                            android:text="问题反馈"
                            android:textAllCaps="false"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/tv_text_body" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/btnLogout"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_btn_primary"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/tabSettings"
                        android:text="退出登录"
                        android:textAllCaps="false"
                        android:textColor="@color/text_white"
                        android:textSize="@dimen/tv_text_section"
                        android:textStyle="bold" />

                </LinearLayout>

            </ScrollView>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
